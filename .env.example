# Firebase Configuration (Get from Firebase Console: Project Settings > Web App)
# DO NOT commit actual values to this file. Use .env.local for local development.
# For production deployment, set these as GitHub Secrets.

# Firebase API Key - Found in Firebase Console under project settings
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Auth Domain - Format: your-project.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase Project ID - Found in Firebase Console
VITE_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket - Format: your-project.appspot.com
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Firebase Messaging Sender ID - Found in Firebase Console
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Firebase App ID - Found in Firebase Console
VITE_FIREBASE_APP_ID=your_app_id

# Application Environment
VITE_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_PHOTO_COMPRESSION=true

# Security Settings
VITE_SESSION_TIMEOUT_MINUTES=30
VITE_MAX_PHOTO_SIZE_MB=5
